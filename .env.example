# AWS Infrastructure Settings
AWS_REGION=us-east-1
STOCK_MENTIONS_TABLE=StockMentions
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:stock-scoring-alerts
DYNAMODB_ENDPOINT_URL=

# Groq LLM Inference (Llama 3)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Reddit Social Ingestion (PRAW)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=StockScoringEngine/2.0
SUBREDDITS=wallstreetbets,stocks,options
POST_LIMIT=200

# Discord Notifications
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# Pipeline Thresholds
SPIKE_THRESHOLD_PERCENT=150.0
TOTAL_SCORE_THRESHOLD=75.0

